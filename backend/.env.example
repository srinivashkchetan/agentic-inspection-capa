# Copy to .env and fill in. Never commit real secrets.

# Anthropic API key. If unset, the generation stage runs in offline "stub"
# mode and returns a deterministic, source-cited draft (useful for UI dev and
# tests without spending tokens).
ANTHROPIC_API_KEY=

# GenAI model tier for the MVP (single tier per PRD §9.1).
CAPA_MODEL=claude-opus-4-8

# Path to the seed/test dataset (relative to repo root or absolute).
CAPA_DATA_PATH=../reports/inspection_reports_all.json

# CORS: comma-separated origins allowed to call the API (the Next.js dev server).
CAPA_CORS_ORIGINS=http://localhost:3000

# Relational store. SQLite by default (zero infra). For Postgres, start
# docker-compose and use e.g.:
#   CAPA_DATABASE_URL=postgresql+psycopg://capa:capa@localhost:5432/capa
CAPA_DATABASE_URL=
CAPA_SEED_ON_START=true

# RAG retriever: auto (Chroma if installed, else seed) | chroma | seed
CAPA_RETRIEVER=auto
CAPA_CHROMA_PATH=.chroma
CAPA_RAG_TOP_K=3
